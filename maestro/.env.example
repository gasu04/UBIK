# =============================================================================
# UBIK Maestro - Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with '#' are comments.
# Variables marked "(required)" have NO default — Maestro will refuse to start
# without them.
# =============================================================================

# -----------------------------------------------------------------------------
# UBIK Project Root
# -----------------------------------------------------------------------------
# Auto-detected at runtime:
#   macOS  → /Volumes/990PRO 4T/UBIK
#   Linux  → /home/gasu/ubik
# Override only if your layout differs.
# UBIK_ROOT=/Volumes/990PRO 4T/UBIK

# -----------------------------------------------------------------------------
# Maestro Orchestrator
# -----------------------------------------------------------------------------
# default: {UBIK_ROOT}/logs/maestro/
MAESTRO_LOG_DIR=
MAESTRO_CHECK_INTERVAL_S=300            # health-check loop interval (seconds)
MAESTRO_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# -----------------------------------------------------------------------------
# Hippocampal Node — Mac Mini M4 Pro (macOS)
# -----------------------------------------------------------------------------
HIPPOCAMPAL_TAILSCALE_IP=100.103.242.91
HIPPOCAMPAL_TAILSCALE_HOSTNAME=ubik-hippocampal

# -----------------------------------------------------------------------------
# Somatic Node — RTX 5090 (native Ubuntu 26.04, migrated off WSL2 2026-09-20)
# -----------------------------------------------------------------------------
# This is a shared home server (hostname acefsan-A100) — a different local
# account (acefsan) also runs unrelated services (Immich, Plex, etc.) on it.
# SOMATIC_TAILSCALE_IP is this box's Tailscale IP on the shared home tailnet
# (device `acefsan-ubuntu`). Verify with `tailscale status` before changing.
# SOMATIC_SSH_HOST should match (plain OpenSSH, no WSL wrapping — see
# SOMATIC_USE_WSL below). SSH key auth as user `gasu` must be set up manually;
# see somatic/README or ubik_sessions.md 2026-09-20 entry for the migration
# narrative.
SOMATIC_TAILSCALE_IP=100.92.12.89
SOMATIC_TAILSCALE_HOSTNAME=ubik-somatic
SOMATIC_SSH_HOST=100.92.12.89
SOMATIC_USE_WSL=false

# -----------------------------------------------------------------------------
# Neo4j Graph Database  (runs on Hippocampal Node)
# -----------------------------------------------------------------------------
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
# (required) — set this to your Neo4j password
NEO4J_PASSWORD=

# -----------------------------------------------------------------------------
# ChromaDB Vector Store  (runs on Hippocampal Node)
# -----------------------------------------------------------------------------
CHROMADB_PORT=8001
# (required) — set this to your ChromaDB bearer token
CHROMADB_TOKEN=

# -----------------------------------------------------------------------------
# MCP Server  (runs on Hippocampal Node)
# -----------------------------------------------------------------------------
MCP_PORT=8080

# -----------------------------------------------------------------------------
# vLLM Inference Server  (runs on Somatic Node)
# -----------------------------------------------------------------------------
VLLM_PORT=8002
VLLM_MODEL_PATH=/home/gasu/ubik/models/deepseek-awq/DeepSeek-R1-Distill-Qwen-14B-AWQ
# Venv vLLM runs in. maestro's remote launcher (vllm_service._remote_start)
# invokes <VLLM_VENV_PATH>/bin/python explicitly, overriding vllm_server.py's
# shebang — so this selects the vLLM version (and its CUDA stack). Two venvs
# coexist on Somatic: pytorch_env_vllm024 (vLLM 0.24.0 + torch 2.11 +cu129,
# the active install since 2026-07-20) and pytorch_env (vLLM 0.13.0 + cu128,
# retained as the rollback). Set this to switch versions without reinstalling.
# The unit also receives VLLM_USE_FLASHINFER_SAMPLER=0 from _BLACKWELL_ENV
# (required by 0.24 on Blackwell sm_120; harmless on 0.13).
VLLM_VENV_PATH=/home/gasu/pytorch_env_vllm024
